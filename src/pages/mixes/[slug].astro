---
import Layout from '../../layouts/Layout.astro';
import Waveform from '../../components/Waveform.astro';
import { mixes } from '../../data/mixes.js';

export function getStaticPaths() {
  return mixes.map((mix) => ({
    params: { slug: mix.slug },
    props: { mix },
  }));
}

const { mix } = Astro.props;

const embedSrc = `https://w.soundcloud.com/player/?url=${encodeURIComponent(
  mix.soundcloudUrl
)}&color=%23e0392a&auto_play=false&show_teaser=false`;
---

<Layout title={`${mix.title} — Flatmate`}>
  <section class="wrap">
    <a class="back" href="/mixes">&larr; All mixes</a>
    <Waveform seed={mix.slug} bars={48} />
    <h1>{mix.title}</h1>
    {mix.date && <p class="mix-date">{mix.date}</p>}
    {mix.description && <p class="description">{mix.description}</p>}

    {mix.soundcloudUrl && (
      <iframe
        title={mix.title}
        width="100%"
        height="166"
        style="margin-top: 24px; border: 2px solid var(--fm-ink);"
        scrolling="no"
        frameborder="no"
        allow="autoplay"
        src={embedSrc}
      ></iframe>
    )}
  </section>
</Layout>

<style>
  .wrap { padding: var(--space-5) var(--space-3) var(--space-5); max-width: 680px; }
  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-decoration: none;
    color: var(--fm-ink);
    margin-bottom: var(--space-3);
  }
  h1 { margin-top: var(--space-3); font-size: var(--text-h2); }
  .mix-date { margin-top: var(--space-1); }
  .description { margin-top: var(--space-2); }
</style>

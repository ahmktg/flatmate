---
import Layout from '../../layouts/Layout.astro';
import Waveform from '../../components/Waveform.astro';
import { getMixes } from '../../lib/notion.js';

let mixes = [];
try {
  mixes = await getMixes();
} catch (e) {
  mixes = [];
}
---

<Layout title="Mixes — Flatmate">
  <section class="wrap">
    <h1>Mixes</h1>

    {mixes.length === 0 && (
      <p class="empty">
        No mixes yet — add a row to the Notion database to publish one here.
      </p>
    )}

    <div class="mix-list">
      {mixes.map((mix) => (
        <a class="mix-row" href={`/mixes/${mix.slug}`}>
          <Waveform seed={mix.id} bars={24} />
          <div class="meta">
            <span class="mix-title">{mix.title}</span>
            {mix.date && <span class="mix-date">{mix.date}</span>}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .wrap { padding: var(--space-5) var(--space-3) var(--space-5); }
  h1 { margin-bottom: var(--space-3); }
  .empty { color: var(--fm-ink); }
  .mix-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .mix-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    padding: var(--space-2);
    border: var(--border);
    transition: background 0.15s ease;
  }
  .mix-row:hover, .mix-row:focus-visible {
    background: var(--fm-red);
    color: var(--fm-off-white);
  }
  .mix-row:hover .mix-date, .mix-row:focus-visible .mix-date {
    color: var(--fm-off-white);
  }
  .mix-row .waveform {
    width: 110px;
    height: 32px;
    flex-shrink: 0;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mix-title {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .mix-date {
    color: var(--fm-ink);
    opacity: 0.7;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Waveform from '../components/Waveform.astro';
import { getMixes, getSiteContent } from '../lib/notion.js';

let mixes = [];
let content = {};
try {
  mixes = (await getMixes()).slice(0, 3);
} catch (e) {
  mixes = [];
}
try {
  content = await getSiteContent();
} catch (e) {
  content = {};
}

const tagline = content.homepage_tagline || 'pressed flat, played loud';
const bio =
  content.homepage_bio ||
  "Irish expat, NYC-based DJ with a wide range of taste — house, disco, whatever else earns its spot in the set. The goal is simple: play the tunes people are still thinking about on the walk home.";
---

<Layout title="Flatmate — DJ & Producer">
  <section class="hero wrap">
    <img
      class="stack-logo"
      src="/brand/flatmate-stack-red.svg"
      alt="Flatmate"
    />
    <p class="tagline">{tagline}</p>
  </section>

  <section class="wrap bio">
    <p>{bio}</p>
  </section>

  {mixes.length > 0 && (
    <section class="wrap latest">
      <p class="eyebrow">Latest mixes</p>
      <div class="mix-list">
        {mixes.map((mix) => (
          <a class="mix-row" href={`/mixes/${mix.slug}`}>
            <Waveform seed={mix.id} bars={24} />
            <span class="mix-title">{mix.title}</span>
          </a>
        ))}
      </div>
      <a class="see-all" href="/mixes">All mixes →</a>
    </section>
  )}

  <section class="cta section-navy">
    <div class="wrap">
      <a class="button button-outline" href="/booking">Book Flatmate</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--space-5) var(--space-3) var(--space-3);
    text-align: center;
  }
  .stack-logo {
    width: min(320px, 70vw);
    height: auto;
  }
  .tagline {
    font-family: var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: var(--text-small);
    color: var(--fm-ink);
    margin-top: var(--space-3);
  }
  .bio {
    padding: var(--space-3) var(--space-3) var(--space-4);
    text-align: center;
    max-width: 620px;
  }
  .latest {
    padding: var(--space-3) var(--space-3) var(--space-4);
  }
  .latest .eyebrow {
    margin-bottom: var(--space-2);
  }
  .mix-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .mix-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    padding: var(--space-2);
    border: var(--border);
  }
  .mix-row .waveform {
    width: 100px;
    height: 32px;
    flex-shrink: 0;
  }
  .mix-title {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .see-all {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fm-red);
    text-decoration: none;
  }
  .cta {
    padding: var(--space-5) 0;
    text-align: center;
  }
</style>
